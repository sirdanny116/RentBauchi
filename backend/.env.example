# Rent Bauchi backend — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the server listens on.
PORT=5000

# The public URL of this deployment (used by the email links, etc.).
APP_URL=http://localhost:5000

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: comma-separated allowed browser origins. Leave as * for "any origin"
# (required if you serve the frontend separately). Restrict for production:
# CORS_ORIGINS=https://rentbauchi.example.com,https://admin.example.com
CORS_ORIGINS=*

# Optional: require this key on first-run admin setup (backend/setup).
# SETUP_KEY=your-secret-setup-key

# Email (Nodemailer SMTP). Leave SMTP_USER/SMTP_PASS blank for demo mode —
# password-reset codes are then returned in the API response instead of emailed.
# Note: Render's free tier blocks outbound SMTP (ports 25/465/587), so on free
# instances set BREVO_* below instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rent Bauchi <no-reply@rentbauchi.test>

# Email via Brevo (https://brevo.com) HTTP API — required on HTTPS-only hosts
# that block SMTP (e.g. Render free tier). No domain needed; verify BREVO_FROM_EMAIL
# once in the Brevo dashboard. Free: 300 emails/day.
# Get an API key: Brevo dashboard -> SMTP & API -> API Keys.
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=you@example.com
# BREVO_FROM_NAME=Rent Bauchi

# Optional overrides:
# DB_FILE=/var/data/rent-bauchi.db
# UPLOAD_DIR=/var/data/uploads
# Static assets cache max age for the browser (ms or e.g. "7d").
# STATIC_MAX_AGE=7d
# WAL checkpoint interval for durable SQLite persistence (ms).
# DB_CHECKPOINT_MS=60000